<mjml lang="en">
  <mj-head>
    <mj-font name="Poppins" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900&display=swap" />
    <mj-raw>
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
    </mj-raw>
    <mj-style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      @media (prefers-color-scheme: light) {
        .dark_img { display: none !important; }
        .light_img { display: block !important; }
      }
      @media (prefers-color-scheme: dark) {
        .dark_img { display: block !important; }
        .light_img { display: none !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text align="center" padding-bottom="12px">
          <a href="{{ app_url }}" target="_blank">
            <span class="light_img" style="display: block;">
              <img width="200" src="https://cdn.cocoonmail.com/assets/ccnm-logo-dark.png" alt="{{ app_name }}" />
            </span>
            <!--[if !mso]><!-->
            <span class="dark_img" style="display: none;">
              <img width="200" src="https://cdn.cocoonmail.com/assets/ccnm-logo-light.png" alt="{{ app_name }}" />
            </span>
            <!--<![endif]-->
          </a>
        </mj-text>
        <mj-text align="center" font-family="Poppins, sans-serif" font-size="20px" color="#333333" font-weight="500">Welcome to {{ app_name }}!</mj-text>
        <mj-text align="center" font-family="Poppins, sans-serif" font-size="14px" color="#666666">We're delighted to have you as a part of our growing community.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-family="Poppins, sans-serif" font-size="16px" line-height="1.6" color="#333333">Hello,</mj-text>
        <mj-text font-family="Poppins, sans-serif" font-size="16px" line-height="1.6" color="#333333">Thank you for registering with us. We're happy to inform you that you have been added to the workspace <strong>{{ workspace_name }}</strong> with email {{ user_with_mail }}.</mj-text>
        <mj-text font-family="Poppins, sans-serif" font-size="16px" line-height="1.6" color="#333333">We are excited to have you on board and look forward to collaborating with you in the workspace.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f9f9f9" padding="20px">
      <mj-column>
        <mj-divider border-color="#E0E0E0" />
        <mj-text align="center" font-family="Poppins, sans-serif" font-size="12px" color="#999999" line-height="1.5">&copy; {{ current_year }} {{ app_name }}. All rights reserved.<br />Need assistance? <a href="mailto:{{ support_mail }}" style="color: #007BFF; text-decoration: none;">Contact Support</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>