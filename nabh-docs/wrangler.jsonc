{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nabh-docs",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DATA_STORE": "postgres",
    "POSTGRES_SSL": "no-verify",
    "SMTP_HOST": "mbox.inofinix.com",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "SMTP_USER": "nabh@cocoonmail.com",
    "SMTP_FROM": "NABH Readiness System <nabh@cocoonmail.com>"
  },

  "containers": [
    {
      "class_name": "NabhApp",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "NABH_APP", "class_name": "NabhApp" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NabhApp"] }]
}
