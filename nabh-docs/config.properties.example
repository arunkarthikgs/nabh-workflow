# Local secrets only. Copy to config.properties and fill in the values.
# config.properties is ignored by Git; everything non-secret lives in config.defaults.properties.
# In production these are set as Cloudflare Worker secrets instead:
#   npx wrangler secret put R2_ACCESS_KEY_ID
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# Only when DATA_STORE=postgres.
# POSTGRES_URL=postgres://user:password@127.0.0.1:5432/nabh_docs
# POSTGRES_PASSWORD=your-postgres-password

# OnlyOffice integration.
# ONLYOFFICE_DOCUMENT_SERVER_URL=https://onlyoffice.example.test
# ONLYOFFICE_JWT_SECRET=your-onlyoffice-jwt-secret

# Outbound email (welcome/set-password links). Without these, mail falls back to a local
# dev outbox (output/outbox/*.json) - NOT usable in production, since container storage
# is ephemeral. Set as Cloudflare Worker secrets in production, same as the keys above.
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=NABH Readiness Platform <no-reply@your-domain.test>
# Optional additional recipient for hospital onboarding approval notifications.
# ONBOARDING_APPROVAL_EMAIL_TO=operations@example.com

# Template Studio ("story" -> DOCX template generation). Requires an OpenAI-compatible API key.
# AI_TEMPLATE_API_KEY=your-openai-api-key
# AI_TEMPLATE_MODEL=gpt-4o-mini
# Optional. Point at an Azure OpenAI or self-hosted OpenAI-compatible endpoint instead.
# AI_TEMPLATE_BASE_URL=https://api.openai.com/v1
