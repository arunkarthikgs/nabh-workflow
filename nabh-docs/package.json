{
  "name": "nabh-docs",
  "version": "1.0.0",
  "type": "module",
  "description": "Master List of Documents workflow - reads the department document register (Google Sheets or a local .xlsx export) and reports the applicable documents per department.",
  "scripts": {
    "master-list": "node workflows/masterListWorkflow.js",
    "master-list:local": "node workflows/masterListWorkflow.js --local",
    "match-documents": "node workflows/documentMatchingWorkflow.js",
    "server": "node server.js",
    "db:migrate": "DATA_STORE=postgres node scripts/migrateToPostgres.js",
    "db:reset-hospitals": "DATA_STORE=postgres RESET_HOSPITAL_DOMAIN=1 node scripts/resetHospitalsAndUsers.js",
    "ui": "npm --prefix web run dev",
    "ui:build": "npm --prefix web run build",
    "prototype": "node workflows/generateFullStaticPrototype.js",
    "aac-policy:word": "zsh workflows/createAacPolicyWordCopy.sh",
    "aac-policy:clean": "node workflows/removeAacPolicyWatermark.js",
    "aac-policy:presentation": "npm run aac-policy:word && zsh workflows/exportAacPolicyModifiedPdf.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@cloudflare/containers": "^0.3.7",
    "docx": "^9.7.1",
    "docx-templates": "^4.15.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "googleapis": "^178.0.0",
    "jszip": "^3.10.1",
    "nodemailer": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
