# Public URL of this NABH Docs server, reachable by OnlyOffice.
PUBLIC_BASE_URL=https://nabh-docs.example.com

# OnlyOffice Document Server URL and matching JWT secret.
ONLYOFFICE_DOCUMENT_SERVER_URL=https://onlyoffice.example.com
ONLYOFFICE_JWT_SECRET=replace-with-a-long-random-secret

# Cloudflare R2 template library. When enabled, templates are loaded from:
# bucket nbah-repo, prefix Templates/
R2_ENABLED=false
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=nbah-repo
R2_TEMPLATE_PREFIX=Templates/
R2_CLIENT_FOLDER=Clients/
# R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com